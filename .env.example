# Copy to .env.local and fill in. .env.local is gitignored.

# Google OAuth 2.0 credentials — https://console.cloud.google.com/
#   1. Create a project and enable the Gmail API
#   2. Create an OAuth client ID of type "Web application"
#   3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   4. On the consent screen, add the gmail.modify scope and yourself as a test user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signing key for the NextAuth session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Must match the origin the app is served from.
# In production set this to your deployed https:// origin.
NEXTAUTH_URL=http://localhost:3000
